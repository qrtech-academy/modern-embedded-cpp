# Ignore everything without an extension.
*
!*.*
!*/

# Don't ignore makefiles.
!makefile
!Makefile

# Don't ignore license files.
!LICENSE

# Ignore .txt files.
*.txt

# Ignore solution files.
*atsln

# Ignore CMake files other than CMakeLists.txt.
*CMakeCache.txt
*CMakeFiles
*cmake_install.Makefile
*cmake_install.cmake

# Ignore Python cache.
*__pycache__/

# Ignore vscode directory.
*vscode/
*vs/

# Ignore debug folder.
*Debug/

# Ignore compiler output that has an extension.
*.o
*.d
*.out
*.exe

# Ignore metadata that Windows (through WSL) and macOS leave beside copied files.
*:Zone.Identifier
.DS_Store

# Keep CMakeLists.txt, which the *.txt rule above would otherwise ignore.
!CMakeLists.txt
